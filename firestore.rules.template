rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isClinicAdmin() {
      return request.auth != null
        && request.auth.token.email == "ADMIN_EMAIL_REPLACE_ME";
    }

    match /faq/{questionId} {
      // Visitors may submit questions, but cannot read, edit, approve, or delete them.
      allow create: if request.resource.data.keys().hasAll([
          "name", "question", "answer", "approved", "createdAt"
        ])
        && request.resource.data.keys().hasOnly([
          "name", "question", "answer", "approved", "createdAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.question is string
        && request.resource.data.question.size() > 0
        && request.resource.data.question.size() <= 1000
        && request.resource.data.answer == ""
        && request.resource.data.approved == false;

      allow read: if isClinicAdmin();
      allow update: if isClinicAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["approved", "answer", "answeredAt"]);
      allow delete: if isClinicAdmin();
    }
  }
}
